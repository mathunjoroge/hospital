# Application Configuration
SECRET_KEY=change-this-to-a-secure-random-secret-key
FLASK_DEBUG=false
FLASK_ENV=development

# Database Configuration
SQLALCHEMY_DATABASE_URI=sqlite:///hims.db
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=hospital_umls
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres

# Redis Cache & Session Configuration
REDIS_HOST=localhost
REDIS_PORT=6379

# DrugCentral External DB (Optional)
DRUGCENTRAL_HOST=unmtid-dbs.net
DRUGCENTRAL_PORT=5433
DRUGCENTRAL_DB=drugcentral
DRUGCENTRAL_USER=drugman
DRUGCENTRAL_PASSWORD=dosage

# AI & Medical NLP API Keys
NVIDIA_API_KEY=your_nvidia_api_key_here
GEMINI_API_KEY=your_gemini_api_key_here
NVIDIA_NIM_MODEL=meta/llama-3.2-11b-vision-instruct

# Local Terminology & Model Paths
LOCAL_TERMINOLOGY=umls_local
LOCAL_TERMINOLOGY_PATH=postgresql://postgres:postgres@localhost:5432/hospital_umls
LOCAL_TERMINOLOGY_TYPE=postgres
MODEL_NAME=microsoft/BiomedNLP-PubMedBERT-base-uncased-abstract
MAX_LENGTH=512
BATCH_SIZE=8
EMBEDDING_DIM=768
SIMILARITY_THRESHOLD=0.9
CONFIDENCE_THRESHOLD=0.85
MIN_CONFIDENCE_THRESHOLD=0.6
CACHE_DIR=data_cache
BACKUP_DIR=backups

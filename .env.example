# =====================================================================
# HMIS .env.example — copy to .env and fill in real values
# NEVER commit .env to source control
# =====================================================================

# ── Flask ─────────────────────────────────────────────────────────────
SECRET_KEY=change-this-to-a-long-random-string-min-32-chars
FLASK_ENV=production
FLASK_DEBUG=false

# ── Security & Authentication Isolation ───────────────────────────────
JWT_SECRET_KEY=   # required in production — set a strong random key (min 32 chars)
DEFAULT_ADMIN_PASSWORD=   # required on initial boot — set a strong password
ENCRYPTION_KEY=   # required — base64 32-byte Fernet key from `python3 -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"`

# ── Scaling & Performance ─────────────────────────────────────────────
WEB_CONCURRENCY=4

# ── Core database (PostgreSQL) ────────────────────────────────────────
# Used by the Flask app for all HMIS data
POSTGRES_USER=hospital
POSTGRES_PASSWORD=   # required — set a strong random value
POSTGRES_DB=hospital_core
POSTGRES_HOST=postgres
POSTGRES_PORT=5432

# SQLAlchemy URI — overridden in docker-compose to use the service name
SQLALCHEMY_DATABASE_URI=postgresql://hospital:CHANGE_ME@postgres:5432/hospital_core

# ── UMLS/terminology database (separate Postgres DB) ─────────────────
# UMLS_DB_URI=postgresql://postgres:postgres@localhost:5432/hospital_umls

# ── Redis ─────────────────────────────────────────────────────────────
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=   # required — set a strong random value

# ── Flask-Limiter storage ─────────────────────────────────────────────
RATELIMIT_STORAGE_URI=redis://:CHANGE_ME@redis:6379/1

# ── Email (Flask-Mail) ────────────────────────────────────────────────
MAIL_SERVER=smtp.example.com
MAIL_PORT=587
MAIL_USE_TLS=true
MAIL_USERNAME=
MAIL_PASSWORD=

# ── AI / NLP API keys ─────────────────────────────────────────────────
NVIDIA_API_KEY=
GEMINI_API_KEY=
NVIDIA_NIM_MODEL=meta/llama-3.2-11b-vision-instruct

# ── Model / processing parameters ────────────────────────────────────
MODEL_NAME=microsoft/BiomedNLP-PubMedBERT-base-uncased-abstract
MAX_LENGTH=512
BATCH_SIZE=8
EMBEDDING_DIM=768
SIMILARITY_THRESHOLD=0.9
CONFIDENCE_THRESHOLD=0.85
MIN_CONFIDENCE_THRESHOLD=0.6
CACHE_DIR=data_cache
BACKUP_DIR=backups

# ── DrugCentral (optional external DB) ───────────────────────────────
DRUGCENTRAL_HOST=unmtid-dbs.net
DRUGCENTRAL_PORT=5433
DRUGCENTRAL_DB=drugcentral
DRUGCENTRAL_USER=drugman
DRUGCENTRAL_PASSWORD=dosage

# ── M-Pesa (Safaricom Daraja API) ───────────────────────────
MPESA_ENV=sandbox
MPESA_CONSUMER_KEY=your-daraja-consumer-key
MPESA_CONSUMER_SECRET=your-daraja-consumer-secret
MPESA_BUSINESS_SHORTCODE=174379
MPESA_PASSKEY=bfb279f9aa9bdbcf158e97dd71a467cd2e0c893059b10f78e6b72ada1ed2c919
MPESA_CALLBACK_URL=https://your-domain.com/billing/mpesa/callback

# Enable telemedicine feature
ENABLE_TELEMEDICINE=false  # disabled by default; enable only after KMPDC licensing is obtained

# ── Orthanc PACS (Phase 5 — P5-01) ──────────────────────────────────────────
ORTHANC_USER=orthanc
ORTHANC_PASSWORD=   # required — set a strong random value
ORTHANC_URL=http://orthanc:8042

# ── MinIO object storage (P5-07 / P2-07) ─────────────────────────────────────
# MinIO must be deployed separately; see docs/minio_setup.md
MINIO_ENDPOINT=http://minio:9000
MINIO_ACCESS_KEY=   # required
MINIO_SECRET_KEY=   # required
MINIO_BUCKET=hmis-dicom

# ── Mirth Connect (Phase 4) ───────────────────────────────────────────────────
MIRTH_KEYSTORE_PASS=   # required — set a strong random value
HL7_INGEST_API_KEY=   # required — set a strong random value

# ── SSO / OIDC (Phase 6) ─────────────────────────────────────────────────────
# Set OIDC_ISSUER to your Keycloak realm URL once Keycloak is deployed.
# Example: https://keycloak.your-domain.com/realms/hospital
OIDC_ISSUER=
OIDC_CLIENT_ID=
OIDC_CLIENT_SECRET=   # required when OIDC_ISSUER is set

# ── Sentry (P2-03) ───────────────────────────────────────────────────────────
SENTRY_DSN=   # required in production — use self-hosted Sentry for DPA 2019 compliance

# ── PostgreSQL streaming replication (P2-09) ──────────────────────────────────
# Create this low-privilege user on the primary before starting the replica:
#   CREATE ROLE replicator WITH REPLICATION LOGIN PASSWORD '...';
POSTGRES_REPLICATION_USER=replicator
POSTGRES_REPLICATION_PASSWORD=   # required — set a strong random value

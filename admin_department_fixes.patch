+                  <span class="badge bg-success">SMS</span>
+                {% elif log.channel == 'EMAIL' %}
+                  <span class="badge bg-primary">Email</span>
+                {% elif log.channel == 'PUSH' %}
+                  <span class="badge bg-info text-dark">Push</span>
+                {% else %}
+                  <span class="badge bg-secondary">{{ log.channel or '—' }}</span>
+                {% endif %}
+              </td>
+              <td class="small">{{ log.event_type or '—' }}</td>
+              <td class="small text-truncate" style="max-width:200px;" title="{{ log.subject }}">
+                {{ log.subject or '—' }}
+              </td>
+              <td>
+                {% if log.status == 'SENT' %}
+                  <span class="badge bg-success">SENT</span>
+                {% elif log.status == 'FAILED' %}
+                  <span class="badge bg-danger">FAILED</span>
+                {% elif log.status == 'PENDING' %}
+                  <span class="badge bg-warning text-dark">PENDING</span>
+                {% else %}
+                  <span class="badge bg-secondary">{{ log.status or '—' }}</span>
+                {% endif %}
+              </td>
+              <td class="small text-danger text-truncate" style="max-width:180px;" title="{{ log.error_message }}">
+                {{ log.error_message or '' }}
+              </td>
+            </tr>
+            {% endfor %}
+          </tbody>
+        </table>
+      </div>
+      {% else %}

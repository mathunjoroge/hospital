+        <i class="bi bi-bell-slash display-4 mb-3 d-block"></i>
+        <p>No outbound notification records found.</p>
+      </div>
+      {% endif %}
+    </div>
+
+    <!-- Pagination -->
+    {% if pagination.pages > 1 %}
+    <div class="card-footer bg-white border-0 py-3">
+      <nav>
+        <ul class="pagination pagination-sm justify-content-center mb-0">
+          {% if pagination.has_prev %}
+          <li class="page-item">
+            <a class="page-link" href="{{ url_for('admin.outbound_notifications', page=pagination.prev_num, event_type=event_filter, status=status_filter, recipient=recipient_filter) }}">&laquo; Prev</a>
+          </li>
+          {% endif %}
+          <li class="page-item disabled"><span class="page-link">{{ pagination.page }} / {{ pagination.pages }}</span></li>
+          {% if pagination.has_next %}
+          <li class="page-item">
+            <a class="page-link" href="{{ url_for('admin.outbound_notifications', page=pagination.next_num, event_type=event_filter, status=status_filter, recipient=recipient_filter) }}">Next &raquo;</a>
+          </li>
+          {% endif %}
+        </ul>
+      </nav>
+    </div>
+    {% endif %}
+  </div>
+</div>
+{% endblock %}

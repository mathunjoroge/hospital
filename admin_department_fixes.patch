@@ -0,0 +1,129 @@
+{% extends "base.html" %}
+{% block content %}
+<div class="container-fluid py-4 px-4">
+
+  <!-- Header -->
+  <div class="d-flex justify-content-between align-items-center mb-4">
+    <div>
+      <h3 class="fw-bold mb-0"><i class="bi bi-patch-check me-2 text-primary"></i>Staff Credentials</h3>
+      <small class="text-muted">Professional licences and certification expiry tracker. Sorted by soonest expiry.</small>
+    </div>
+    <div class="d-flex gap-2">
+      <a href="{{ url_for('admin.staff_credential_alerts') }}" target="_blank"
+         class="btn btn-outline-warning btn-sm">
+        <i class="bi bi-exclamation-triangle me-1"></i> Expiry Alerts (30d)
+      </a>
+      <a href="{{ url_for('admin.staff_credentials', format='json') }}" target="_blank"
+         class="btn btn-outline-primary btn-sm">
+        <i class="bi bi-filetype-json me-1"></i> Export JSON
+      </a>
+      <a href="{{ url_for('admin.index') }}" class="btn btn-outline-secondary btn-sm">
+        <i class="bi bi-arrow-left me-1"></i> Dashboard
+      </a>
+    </div>
+  </div>
+
+  <!-- Add Credential Form -->
+  <div class="card shadow-sm border-0 mb-4">
+    <div class="card-header bg-white fw-bold border-0">
+      <i class="bi bi-plus-circle me-2 text-success"></i>Add New Credential
+    </div>
+    <div class="card-body">
+      <form method="POST" action="{{ url_for('admin.staff_credentials') }}" class="row g-3">
+        <input type="hidden" name="csrf_token" value="{{ csrf_token() }}"/>
+        <div class="col-md-3">
+          <label class="form-label small fw-bold text-muted">Staff Name</label>
+          <input type="text" name="staff_name" class="form-control form-control-sm"
+                 placeholder="Full name" required>
+        </div>
+        <div class="col-md-2">
+          <label class="form-label small fw-bold text-muted">Employee ID</label>
+          <input type="text" name="employee_id" class="form-control form-control-sm"
+                 placeholder="Optional">
+        </div>
+        <div class="col-md-2">
+          <label class="form-label small fw-bold text-muted">Credential Type</label>
+          <input type="text" name="credential_type" class="form-control form-control-sm"
+                 placeholder="e.g. Medical Licence" required>
+        </div>
+        <div class="col-md-2">
+          <label class="form-label small fw-bold text-muted">Credential Number</label>
+          <input type="text" name="credential_number" class="form-control form-control-sm"
+                 placeholder="e.g. ML-2024-001" required>
+        </div>
+        <div class="col-md-2">
+          <label class="form-label small fw-bold text-muted">Expiry Date</label>
+          <input type="date" name="expiry_date" class="form-control form-control-sm" required>
+        </div>
+        <div class="col-md-1 d-flex align-items-end">
+          <button type="submit" class="btn btn-sm btn-success w-100">
+            <i class="bi bi-plus"></i> Add
+          </button>
+        </div>
+      </form>
+    </div>
+  </div>
+
+  <!-- Credentials Table -->
+  <div class="card shadow-sm border-0">
+    <div class="card-header bg-white py-3 border-0">
+      <h6 class="m-0 fw-bold text-primary">
+        <i class="bi bi-list-check me-1"></i>{{ items|length }} Credential(s) on Record
+      </h6>
+    </div>
+    <div class="card-body p-0">
+      {% if items %}
+      <div class="table-responsive">
+        <table class="table table-hover align-middle mb-0">
+          <thead class="table-light">
+            <tr>
+              <th>Staff Name</th>
+              <th>Employee ID</th>
+              <th>Type</th>
+              <th>Number</th>
+              <th>Expiry Date</th>
+              <th>Days Left</th>
+              <th>Status</th>
+            </tr>
+          </thead>
+          <tbody>
+            {% for item in items %}
+            <tr class="
+              {% if item.status == 'EXPIRED' %}table-danger
+              {% elif item.status == 'WARNING' %}table-warning
+              {% endif %}">
+              <td class="fw-semibold">{{ item.staff_name }}</td>
+              <td class="small text-muted">{{ item.employee_id or '—' }}</td>
+              <td>{{ item.credential_type }}</td>
+              <td><code class="small">{{ item.credential_number }}</code></td>
+              <td class="small">{{ item.expiry_date }}</td>
+              <td class="fw-semibold
+                {% if item.days_until_expiry < 0 %}text-danger
+                {% elif item.days_until_expiry <= 30 %}text-warning
+                {% else %}text-success{% endif %}">
+                {{ item.days_until_expiry }}d
+              </td>
+              <td>
+                {% if item.status == 'EXPIRED' %}
+                  <span class="badge bg-danger">EXPIRED</span>
+                {% elif item.status == 'WARNING' %}
+                  <span class="badge bg-warning text-dark">EXPIRING SOON</span>
+                {% else %}
+                  <span class="badge bg-success">ACTIVE</span>
+                {% endif %}
+              </td>
+            </tr>
+            {% endfor %}
+          </tbody>
+        </table>
+      </div>
+      {% else %}
+      <div class="p-5 text-center text-muted">
+        <i class="bi bi-patch-question display-4 mb-3 d-block"></i>
+        <p>No staff credentials recorded yet. Use the form above to add the first one.</p>
+      </div>
+      {% endif %}
+    </div>
+  </div>
+</div>
+{% endblock %}

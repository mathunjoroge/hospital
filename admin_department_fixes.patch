+          {{ form.submit(class="btn btn-warning fw-semibold flex-fill") }}
+          <a href="{{ url_for('admin.manage_users') }}" class="btn btn-outline-secondary flex-fill">Cancel</a>
+        </div>
+      </form>
+    </div>
+  </div>
+</div>
+{% endblock %}
